# --- LLM -------------------------------------------------------------------
LLM_PROVIDER=auto              # auto = gemini -> bedrock -> local | gemini | bedrock | local | none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Bedrock: IAM credentials (aws configure) or a Bedrock API key
# AWS_BEARER_TOKEN_BEDROCK=
# BEDROCK_MODEL_ID=eu.anthropic.claude-haiku-4-5-20251001-v1:0
# AWS_REGION=eu-central-1
LLM_CACHE_MODE=off             # off | replay | record
LLM_REQUESTS_PER_MINUTE=0      # throttle for free tiers (0 = off)

# Local engine (Ollama, e.g. on a Mac Studio). From another machine open a tunnel
# first: make engine-tunnel  (= ssh -N -L 11434:127.0.0.1:11434 studio)
ENGINE_BASE_URL=http://127.0.0.1:11434
ASSISTANT_TAG=assistant:32k

# --- Inbox source: a folder of .eml files instead of fixtures/mailbox.json (empty = fixture)
# MAIL_EML_DIR=fixtures/eml

# --- Embeddings ------------------------------------------------------------
EMBEDDING_PROVIDER=auto        # auto (gemini if key, else hashing) | gemini | hashing
EMBEDDING_CACHE_MODE=off

# --- Demo clock: fixed "now" so the fixture inbox makes sense (empty = real time)
FIXED_NOW=2026-11-09T09:00:00+01:00

# --- Observability ---------------------------------------------------------
TRACING_BACKEND=none           # none | mlflow | langsmith
MLFLOW_TRACKING_URI=file:./mlruns
LOG_JSON=true
LOG_LEVEL=INFO
