# --- LLM -------------------------------------------------------------------
LLM_PROVIDER=gemini            # gemini | bedrock (untested) | none (rule-based only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-5-20250929-v1:0
# AWS_REGION=eu-central-1
LLM_CACHE_MODE=off             # off | replay | record
LLM_REQUESTS_PER_MINUTE=0      # throttle for free tiers (0 = off)

# --- Embeddings ------------------------------------------------------------
EMBEDDING_PROVIDER=gemini      # gemini | hashing (offline)
EMBEDDING_CACHE_MODE=off

# --- Demo clock: fixed "now" so the fixture inbox makes sense (empty = real time)
FIXED_NOW=2026-11-09T09:00:00+01:00

# --- Observability ---------------------------------------------------------
TRACING_BACKEND=none           # none | mlflow | langsmith
MLFLOW_TRACKING_URI=file:./mlruns
LOG_JSON=true
LOG_LEVEL=INFO
